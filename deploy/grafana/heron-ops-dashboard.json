          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tool, result) (rate(heron_ops_tool_calls_total{job=~\"$job\", instance=~\"$instance\", result!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{tool}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
